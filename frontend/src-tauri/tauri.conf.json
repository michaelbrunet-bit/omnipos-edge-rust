{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniPOS Edge",
  "version": "0.2.0",
  "identifier": "com.omnipos.edge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniPOS Edge v0.2 • Operator & Customer Terminal",
        "width": 1440,
        "height": 900,
        "minWidth": 375,
        "minHeight": 667,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https: ws: wss:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "app", "dmg"],
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
